---
import { Font } from 'astro:assets'
import LedMatrix from '@/components/LedMatrix.astro'
import PixelIcon from '@/components/PixelIcon.astro'
import { ANIMATION_NAMES } from '@/lib/pixbar/animations/names'
import { posterPixels } from '@/lib/pixbar/preview'
import { display } from '@/lib/server/display'
import { statusText } from '@/lib/status-text'

const status = display().status()
const text = statusText(status)

const STOP = [
  '.......',
  '.#####.',
  '.#####.',
  '.#####.',
  '.#####.',
  '.#####.',
  '.......',
]
const CLEAR = [
  '#.....#',
  '.#...#.',
  '..#.#..',
  '...#...',
  '..#.#..',
  '.#...#.',
  '#.....#',
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Capybara</title>
    <Font cssVariable="--font-pixel" preload />
  </head>
  <body>
    <main>
      <h1>Capybara</h1>
      <p class="lead">Choose what your PixBar shows.</p>

      <div class="shelf">
        {ANIMATION_NAMES.map((name) => (
          <button
            type="button"
            class="pixel tile"
            data-animation={name}
            aria-pressed={status.animation === name ? 'true' : 'false'}
          >
            <LedMatrix pixels={posterPixels(name)} />
            <span class="name">{name}</span>
          </button>
        ))}
      </div>

      <div class="actions">
        <button type="button" class="pixel" id="stop">
          <PixelIcon rows={STOP} /> Stop
        </button>
        <button type="button" class="pixel" id="clear">
          <PixelIcon rows={CLEAR} /> Clear screen
        </button>
      </div>

      <dl class="status">
        <dt>Playing</dt>
        <dd data-status="animation">{text.animation}</dd>
        <dt>Connected</dt>
        <dd data-status="clients">{text.clients}</dd>
      </dl>
      <p class="error" role="alert"></p>
    </main>
  </body>
</html>

<script>
  import { actions } from 'astro:actions'
  import { isAnimationName } from '@/lib/pixbar/animations/names'
  import type { DisplayStatus } from '@/lib/server/display'
  import { statusText } from '@/lib/status-text'

  const errorBox = document.querySelector('.error')!
  const tiles = document.querySelectorAll<HTMLButtonElement>(
    'button[data-animation]',
  )

  function render(status: DisplayStatus) {
    for (const [name, value] of Object.entries(statusText(status))) {
      document.querySelector(`[data-status="${name}"]`)!.textContent = value
    }
    for (const tile of tiles) {
      tile.setAttribute(
        'aria-pressed',
        String(tile.dataset.animation === status.animation),
      )
    }
  }

  /**
   * What every action call resolves to. Astro's own types differ per action
   * (`play` takes input), so the shared shape is spelled out here.
   */
  type Command = () => Promise<{
    data?: DisplayStatus
    error?: { message: string }
  }>

  function bind(button: HTMLButtonElement, action: Command) {
    button.addEventListener('click', async () => {
      button.disabled = true
      try {
        const { data, error } = await action()
        errorBox.textContent = error ? error.message : ''
        // A failed command may still have changed state (clear stops the stream first).
        const status = data ?? (await actions.status()).data
        if (status) render(status)
      } catch (error) {
        errorBox.textContent = `Couldn't reach the server: ${error instanceof Error ? error.message : String(error)}`
      } finally {
        button.disabled = false
      }
    })
  }

  for (const tile of tiles) {
    const animation = tile.dataset.animation
    if (isAnimationName(animation))
      bind(tile, () => actions.play({ animation }))
  }
  bind(document.querySelector('#stop')!, () => actions.stop())
  bind(document.querySelector('#clear')!, () => actions.clear())
</script>

<style>
  body {
    --room: #161b36;
    --matrix: #0b0e1f;
    --led-off: #222a4d;
    --ink: #ecebff;
    --dim: #9096bf;
    --amber: #ffb43b;
    --error: #ff8a8a;
    /* One "pixel" of the UI's own pixel art */
    --px: 3px;
    margin: 0;
    min-height: 100vh;
    background: var(--room);
    color: var(--ink);
    font-family: var(--font-pixel), system-ui, sans-serif;
    font-size: 1.125rem;
    line-height: 1.5;
  }
  main {
    width: min(46rem, 100% - 2.5rem);
    margin: 0 auto;
    padding: 4rem 0 3rem;
  }
  h1 {
    margin: 0;
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .lead {
    margin: 0.5rem 0 2.5rem;
    color: var(--dim);
  }

  /* Pixel-art button: stepped box-shadows draw a border with notched corners,
     and the inset shadow is the shaded lower lip it presses down into. */
  .pixel {
    --edge: #3b4479;
    --face: #232a52;
    margin: var(--px);
    padding: 0.6rem 1rem;
    border: 0;
    background: var(--face);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    box-shadow:
      0 calc(-1 * var(--px)) var(--edge),
      0 var(--px) var(--edge),
      calc(-1 * var(--px)) 0 var(--edge),
      var(--px) 0 var(--edge),
      inset 0 calc(-1 * var(--px)) var(--room);
  }
  .pixel:hover {
    --edge: #5964a6;
  }
  .pixel:active {
    transform: translateY(var(--px));
  }
  .pixel[aria-pressed='true'] {
    --edge: var(--amber);
  }
  .pixel:focus-visible {
    outline: var(--px) dashed var(--amber);
    outline-offset: calc(2 * var(--px));
  }
  .pixel:disabled {
    cursor: progress;
  }

  .shelf {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.25rem;
  }
  .tile {
    display: grid;
    gap: 0.6rem;
    padding: 0.6rem 0.6rem 0.75rem;
    text-align: left;
  }
  .name {
    text-transform: capitalize;
  }
  .tile[aria-pressed='true'] .name {
    color: var(--amber);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.75rem 0 2.5rem;
  }
  .actions .pixel {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .status {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1.5rem;
    margin: 0;
  }
  .status dt {
    color: var(--dim);
  }
  .status dd {
    margin: 0;
  }
  .error {
    min-height: 1.5em;
    color: var(--error);
  }

  @media (prefers-reduced-motion: reduce) {
    .pixel:active {
      transform: none;
    }
  }
</style>
